APP_NAME=StudyPath EU
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Local Docker Compose Postgres + pgvector
DATABASE_URL=postgresql+asyncpg://studypath:studypath@localhost:5432/studypath

# At least 32 characters
JWT_SECRET=change-me-to-a-long-random-secret-key!!
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# OpenAI-compatible API (required at startup even before chat is wired)
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

CORS_ORIGINS=http://localhost:3000
